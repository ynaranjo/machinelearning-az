    <!-- Bienvenida -->
    <string name="welcome_title">¡Bienvenido a KidsGuard!</string>
    <string name="welcome_text">Convierte este dispositivo en un entorno seguro para tus hijos:\n\n📱 Solo podrán usar las apps que tú permitas\n⏱ Con límites de tiempo diarios y hora de dormir\n📊 Y verás cuánto usan cada app\n\nLa configuración tiene 3 pasos:\n\n1️⃣ Crea tu PIN de adulto\n2️⃣ Concede los permisos del sistema\n3️⃣ Elige las apps permitidas y activa el modo niños</string>
