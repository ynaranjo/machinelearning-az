<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Arranque con el dispositivo -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Servicio de vigilancia en primer plano -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Mostrar la pantalla de bloqueo sobre otras apps -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Notificación del servicio (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Detectar la app en primer plano (se concede desde Ajustes) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Listar todas las apps instaladas para que el adulto elija -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".KidsGuardApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.KidsGuard">

        <!-- Entrada para el adulto (icono de la app) -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Launcher infantil: reemplaza la pantalla de inicio -->
        <activity
            android:name=".ui.launcher.KidsHomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.KidsGuard.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.WelcomeActivity" android:exported="false" />
        <activity android:name=".ui.pin.PinSetupActivity" android:exported="false" />
        <activity
            android:name=".ui.pin.PinActivity"
            android:exported="false"
            android:excludeFromRecents="true" />
        <activity android:name=".ui.parent.ParentDashboardActivity" android:exported="false" />
        <activity android:name=".ui.parent.AppSelectionActivity" android:exported="false" />
        <activity android:name=".ui.parent.TimeLimitsActivity" android:exported="false" />
        <activity android:name=".ui.parent.UsageStatsActivity" android:exported="false" />
        <activity android:name=".ui.parent.ProfilesActivity" android:exported="false" />
        <activity android:name=".ui.parent.WeeklyReportActivity" android:exported="false" />
        <activity android:name=".ui.parent.WebFilterActivity" android:exported="false" />
        <activity android:name=".ui.parent.SetupActivity" android:exported="false" />

        <!-- Navegador infantil filtrado -->
        <activity
            android:name=".ui.browser.KidsBrowserActivity"
            android:exported="false" />

        <!-- Pantalla mostrada al bloquear una app -->
        <activity
            android:name=".ui.block.BlockedActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.KidsGuard.Fullscreen" />

        <!-- Bloqueo instantáneo al cambiar de app (sin leer contenido de pantalla) -->
        <service
            android:name=".service.AppBlockerAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Servicio que vigila la app en primer plano -->
        <service
            android:name=".service.AppMonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="parental_control_app_monitoring" />
        </service>

        <!-- Arranque automático al encender el dispositivo -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Administrador de dispositivo: dificulta la desinstalación -->
        <receiver
            android:name=".receiver.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
